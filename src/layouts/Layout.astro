---
import { getImage } from "astro:assets"
import profileImage from "@/assets/profile.png"
import AIContext from "@/components/AIContext.astro"
import Clarity from "@/components/Clarity.astro"
import GlitchFX from "@/components/GlitchFX.astro"
import LanguageSelector from "@/components/LanguageSelector.astro"
import { DEFAULT_LANGUAGE, t } from "@/i18n"
import content from "@/data/content.json"

import "@fontsource-variable/space-grotesk"
import "@fontsource-variable/inter"
import "@fontsource-variable/jetbrains-mono"

interface Props {
  image?: string
}

const { image } = Astro.props

const { profile, profiles, education, work, knowsAbout } = content
const { name, email, phone, url } = profile

const site = Astro.site ?? new URL(Astro.url.origin)
// Desde el pathname y no desde "/", para que respete el base path que el
// workflow inyecta con GITHUB_PAGES_BASE_PATH.
const canonicalUrl = new URL(Astro.url.pathname, site)
const ogImageUrl = new URL(image || "/og-home.png", site)

// Schema.org consumers need an absolute, crawlable URL, so emit a build-time
// derivative rather than pointing at the 1.4 MB source asset.
const profileSchemaImage = await getImage({
  src: profileImage,
  width: 512,
  height: 512,
  format: "webp",
  quality: 85,
})
const profileImageUrl = new URL(profileSchemaImage.src, site)

const sameAs = profiles.map((entry) => entry.url).filter(Boolean)
const currentWork = work.find(({ endDate }) => endDate === null) ?? work[0]

// El JSON-LD sale en el idioma renderizado y no se actualiza al cambiar de
// idioma: lo consumen crawlers, que ven el HTML estático.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  jobTitle: t("hero.label"),
  url: new URL(url, site).href,
  image: profileImageUrl.href,
  email: `mailto:${email}`,
  telephone: phone,
  sameAs,
  worksFor: {
    "@type": "Organization",
    name: t(`experience.jobs.${currentWork.id}.name`),
    ...(currentWork.url ? { url: currentWork.url } : {}),
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: t(`education.schools.${education[0].id}.institution`),
    ...(education[0].url ? { url: education[0].url } : {}),
  },
  knowsAbout,
}
const safeJsonLd = JSON.stringify(jsonLd).replace(/</g, "\\u003c")
---

<!doctype html>
<html lang={DEFAULT_LANGUAGE}>
  <head>
    <meta charset="UTF-8" />
    <title data-i18n="meta.title">{t("meta.title")}</title>
    <meta name="description" data-i18n-attr="content:meta.description" content={t("meta.description")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Open Graph y Twitter los leen crawlers que no ejecutan JS: se quedan en
        el idioma renderizado a propósito, sin marcas para el binder. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t("meta.title")} />
    <meta property="og:description" content={t("meta.description")} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t("meta.ogLocale")} />
    <meta property="og:site_name" content={name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t("meta.title")} />
    <meta name="twitter:description" content={t("meta.description")} />
    <meta name="twitter:image" content={ogImageUrl.href} />

    <script type="application/ld+json" set:html={safeJsonLd}></script>

    <script is:inline>
      window.getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      window.applyTheme = (theme) => {
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      };

      window.applyTheme(window.getThemePreference());

      // Solo el atributo lang, antes del primer pintado: sin impacto visual,
      // pero lectores de pantalla y la heurística del navegador ya leen el
      // idioma correcto aunque el texto todavía no se haya intercambiado.
      const storedLang = localStorage.getItem('lang');
      if (storedLang && /^[a-z]{2}$/.test(storedLang)) {
        document.documentElement.lang = storedLang;
      }
    </script>
    <Clarity id="x9rpajde8s" />
    <script>
      import "@/analytics/tracking";
    </script>
  </head>
  <body>
    <AIContext />
    <div class="bg-effects">
      <div class="bg-grid"></div>
      <div class="bg-gradient-fog"></div>
      <div class="bg-radial-light"></div>
      <div class="bg-noise"></div>
    </div>

    <div class="app-layout">
      <slot />
    </div>

    <LanguageSelector />
    <GlitchFX />

    <script>
      import { apply, subscribeLanguage } from "@/i18n"

      // Única línea de cableado del i18n: `apply` se auto-registra en su primera
      // ejecución y `subscribeLanguage` dispara al suscribirse.
      subscribeLanguage(apply)
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #050505;
    --bg-secondary: #0A0A0F;
    --bg-panel: #0D0D14;
    --bg-panel-hover: #111118;
    --text-primary: #E8E6F0;
    --text-secondary: #9890A8;
    --text-muted: #807A96;
    --border-color: rgba(120, 80, 180, 0.12);
    --border-hover: rgba(140, 100, 200, 0.25);
    --accent-purple: #8B5CF6;
    --accent-purple-dim: rgba(139, 92, 246, 0.15);
    --accent-magenta: rgba(180, 100, 220, 0.6);
    --accent-cyan: rgba(80, 200, 220, 0.5);
    --accent-orange: rgba(240, 160, 80, 0.5);
    --accent-green: rgba(80, 200, 120, 0.6);
    /* Text-safe accents: the decorative values above are tuned for borders,
       dots and glows, and fall below the 4.5:1 contrast floor when used as
       copy. Use these whenever an accent colours actual text. */
    --accent-purple-text: #A78BFA;
    --accent-green-text: #4ADE80;
    --glow-purple: 0 0 20px rgba(139, 92, 246, 0.1);
    --glow-border: 0 0 8px rgba(139, 92, 246, 0.08);
    --font-heading: 'Space Grotesk Variable', 'Space Grotesk', system-ui, sans-serif;
    --font-body: 'Inter Variable', 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono Variable', 'JetBrains Mono', 'Fira Code', monospace;
    --radius-sm: 2px;
    --radius-md: 4px;
    --transition-fast: 150ms ease;
    --transition-normal: 250ms ease;
  }

  :root.dark {
    --bg-primary: #050505;
    --bg-secondary: #0A0A0F;
    --bg-panel: #0D0D14;
    --bg-panel-hover: #111118;
    --text-primary: #E8E6F0;
    --text-secondary: #9890A8;
    --text-muted: #807A96;
    --border-color: rgba(120, 80, 180, 0.12);
    --border-hover: rgba(140, 100, 200, 0.25);
    --accent-purple-text: #A78BFA;
    --accent-green-text: #4ADE80;
  }

  :root:not(.dark) {
    --bg-primary: #F5F3F7;
    --bg-secondary: #EDE8F5;
    --bg-panel: #FFFFFF;
    --bg-panel-hover: #F8F6FC;
    --text-primary: #1A1525;
    --text-secondary: #5A5470;
    --text-muted: #6F6884;
    --border-color: rgba(120, 80, 180, 0.15);
    --border-hover: rgba(120, 80, 180, 0.3);
    --accent-purple-dim: rgba(139, 92, 246, 0.08);
    /* Light mode needs darker accents to clear 4.5:1 against white panels. */
    --accent-purple-text: #6D28D9;
    --accent-green-text: #15803D;
    --glow-purple: 0 0 20px rgba(139, 92, 246, 0.05);
    --glow-border: 0 0 8px rgba(139, 92, 246, 0.03);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  ul {
    list-style: none;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 500;
    line-height: 1.3;
    color: var(--text-primary);
  }

  p {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .bg-effects {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--border-color) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-color) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.4;
  }

  .bg-gradient-fog {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 20% 40%, rgba(139, 92, 246, 0.04), transparent),
      radial-gradient(ellipse 60% 40% at 80% 60%, rgba(80, 200, 220, 0.03), transparent);
    animation: fogDrift 20s ease-in-out infinite alternate;
  }

  @keyframes fogDrift {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-2%, 1%); }
  }

  .bg-radial-light {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.06), transparent 70%);
    filter: blur(40px);
  }

  .bg-noise {
    position: absolute;
    inset: 0;
    opacity: 0.015;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
  }

  .app-layout {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  .print {
    display: none !important;
  }

  @media print {
    .no-print {
      display: none !important;
    }

    .print {
      display: block !important;
    }

    .bg-effects {
      display: none;
    }

    article {
      break-inside: avoid;
    }
  }
</style>
