---
/**
 * Regla de lectura: reemplaza la barra de scroll nativa por una escala fija en
 * el borde derecho que mide cuánto del documento se recorrió.
 *
 * Es un mapa a escala de la página. Cada marca de sección está en
 * `top / scrollHeight`, así que la distancia entre marcas es proporcional al
 * largo real de cada sección, y el cursor cruza una marca en el mismo momento
 * en que esa sección pasa a ser la activa.
 *
 * Con mouse o lápiz se arrastra como una barra de scroll. En touch es solo un
 * indicador, igual que el nativo del móvil. Queda fuera del árbol de
 * accesibilidad y del orden de foco, como la barra que reemplaza: el teclado
 * sigue desplazando la página por su cuenta.
 */
---

<div id="scroll-ruler" class="no-print" aria-hidden="true">
  <div class="ruler-scale">
    <div class="ruler-ticks"></div>
    <div class="ruler-ticks ruler-ticks--passed"></div>
    <div class="ruler-marks"></div>

    <div class="ruler-cursor">
      <span class="ruler-pointer"></span>
      <span class="ruler-readout">
        <span class="ruler-value">0%</span>
        <span class="ruler-section">whoami</span>
      </span>
    </div>

    <div class="ruler-hit" data-track="scroll_ruler"></div>
  </div>
</div>

<script>
  import { subscribeLanguage, t } from "@/i18n"

  /**
   * El hero no lleva título de sección: se nombra con el comando de su barra
   * de terminal (`$ whoami`), que tampoco se traduce.
   */
  const UNTITLED_LABEL = "whoami"
  /** Mismo umbral que BackToTop: con menos recorrido no hay nada que medir. */
  const MIN_SCROLL = 100
  const SCROLL_IDLE_MS = 900
  /** Distancia al cursor dentro de la cual un clic lo agarra en vez de saltar. */
  const GRAB_TOLERANCE = 8

  const ruler = document.getElementById("scroll-ruler")
  const scale = ruler?.querySelector<HTMLElement>(".ruler-scale")
  const marks = ruler?.querySelector<HTMLElement>(".ruler-marks")
  const value = ruler?.querySelector<HTMLElement>(".ruler-value")
  const label = ruler?.querySelector<HTMLElement>(".ruler-section")
  const hit = ruler?.querySelector<HTMLElement>(".ruler-hit")

  if (ruler && scale && marks && value && label && hit) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    // La primera sección no lleva marca: coincide con el 0 de la escala.
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("main section[id]"),
      (element, index) => ({
        element,
        key: element.dataset.titleKey,
        mark: index > 0 ? marks.appendChild(document.createElement("span")) : null,
        y: 0,
      }),
    )

    let language = ""
    let length = 0
    let maxScroll = 0
    let cursorY = 0
    let active = -1
    let percent = -1
    let frame = 0
    let idle = 0

    // Al píxel físico: una línea de 1px en media posición se pinta borrosa.
    const snap = (px: number) => Math.round(px * devicePixelRatio) / devicePixelRatio
    const clamp = (n: number) => Math.min(Math.max(n, 0), 1)

    // offsetTop y no getBoundingClientRect: GlitchFX desplaza las secciones con
    // transforms durante la ráfaga, y una medición en ese momento quedaría corrida.
    const documentTop = (element: HTMLElement) => {
      let top = 0
      for (let node: HTMLElement | null = element; node; node = node.offsetParent as HTMLElement | null) {
        top += node.offsetTop
      }
      return top
    }

    const writeLabel = (animate: boolean) => {
      const key = sections[active]?.key
      label.textContent = key ? t(key, undefined, language) : UNTITLED_LABEL
      if (animate && !reduceMotion.matches) {
        label.animate?.([{ opacity: 0 }, { opacity: 1 }], { duration: 250, easing: "ease-out" })
      }
    }

    const render = () => {
      frame = 0
      if (length <= 0) return

      const progress = maxScroll > 0 ? clamp(window.scrollY / maxScroll) : 0
      cursorY = snap(progress * length)
      ruler.style.setProperty("--y", `${cursorY}px`)

      const nextPercent = Math.round(progress * 100)
      if (nextPercent !== percent) {
        percent = nextPercent
        value.textContent = `${percent}%`
      }

      // Activa es la última sección cuya marca ya alcanzó el cursor, comparando
      // los mismos píxeles redondeados: el texto cambia justo al cruzar la marca.
      let next = 0
      sections.forEach(({ mark, y }, index) => {
        const passed = index > 0 && y <= cursorY
        if (passed) next = index
        mark?.classList.toggle("is-passed", passed)
      })

      if (next !== active) {
        const first = active < 0
        active = next
        writeLabel(!first)
      }
    }

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(render)
    }

    const measure = () => {
      length = scale.offsetHeight - 1
      if (length <= 0) return

      const height = document.documentElement.scrollHeight
      maxScroll = height - window.innerHeight

      for (const section of sections) {
        section.y = snap((documentTop(section.element) / height) * length)
        section.mark?.style.setProperty("top", `${section.y}px`)
      }

      ruler.classList.toggle("is-active", maxScroll > MIN_SCROLL)
      render()
    }

    let measureFrame = 0
    const scheduleMeasure = () => {
      cancelAnimationFrame(measureFrame)
      measureFrame = requestAnimationFrame(measure)
    }

    window.addEventListener(
      "scroll",
      () => {
        schedule()
        ruler.classList.add("is-scrolling")
        clearTimeout(idle)
        idle = window.setTimeout(() => ruler.classList.remove("is-scrolling"), SCROLL_IDLE_MS)
      },
      { passive: true },
    )

    // `resize` cubre el alto de la ventana y el zoom (cambia devicePixelRatio);
    // el ResizeObserver, todo lo que cambia el alto del documento: fuentes que
    // terminan de cargar, textos de otro idioma.
    window.addEventListener("resize", scheduleMeasure)
    if ("ResizeObserver" in window) new ResizeObserver(scheduleMeasure).observe(document.body)

    // `t` con idioma explícito y no el texto del encabezado: así no depende de
    // que el binder haya corrido antes que este suscriptor.
    subscribeLanguage((code) => {
      language = code
      if (active >= 0) writeLabel(false)
    })

    /*
     * Arrastre, solo con mouse y lápiz. En touch la regla es un indicador, como
     * el de scroll nativo del móvil: capturar el borde le robaría el gesto de
     * desplazamiento al pulgar y chocaría con el de volver atrás del sistema.
     */
    let grabOffset = 0
    let dragY = 0
    let dragFrame = 0

    const scrollToDrag = () => {
      dragFrame = 0
      const progress = clamp((dragY - grabOffset - scale.getBoundingClientRect().top) / length)
      // "instant" y no "auto": `auto` hereda el `scroll-behavior: smooth` del
      // html y la página quedaría persiguiendo al puntero.
      window.scrollTo({ top: progress * maxScroll, behavior: "instant" })
    }

    const follow = (clientY: number) => {
      dragY = clientY
      if (!dragFrame) dragFrame = requestAnimationFrame(scrollToDrag)
    }

    hit.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "touch" || event.button !== 0 || length <= 0) return
      event.preventDefault()

      // Agarrar el cursor lo arrastra desde donde está; un clic en la escala lo
      // lleva primero hasta el puntero, como la pista de una barra de scroll.
      const offset = event.clientY - (scale.getBoundingClientRect().top + cursorY)
      grabOffset = Math.abs(offset) <= GRAB_TOLERANCE ? offset : 0

      hit.setPointerCapture(event.pointerId)
      ruler.classList.add("is-dragging")
      follow(event.clientY)
    })

    hit.addEventListener("pointermove", (event) => {
      if (hit.hasPointerCapture(event.pointerId)) follow(event.clientY)
    })

    // pointerup y pointercancel sueltan la captura solos; esto cubre ambos.
    hit.addEventListener("lostpointercapture", () => ruler.classList.remove("is-dragging"))

    measure()
  }
</script>

<style is:global>
  /* La regla ocupa el lugar de la barra nativa. Se oculta solo con JS, que es
     lo que hace funcionar la regla: sin scripts la barra se queda. Va en CSS y
     no en el script para que no haya salto de layout al cargar. */
  @media (scripting: enabled) {
    html {
      scrollbar-width: none;
    }

    html::-webkit-scrollbar,
    body::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<style>
  #scroll-ruler {
    /* Paso entre marcas menores: 50 intervalos de 2 %. En píxeles enteros para
       que todas las líneas de 1px caigan nítidas. */
    --step: 6px;
    --length: calc(var(--step) * 50);
    /* Largo de las marcas, desde la línea base hacia el contenido. Pegada al
       borde son cortas para no invadir el margen de 16px del móvil. */
    --minor: 3px;
    --medium: 5px;
    --mark: 8px;
    --pointer: 10px;
    --y: 0px;

    position: fixed;
    right: 4px;
    top: calc(50% - var(--length) / 2);
    /* Sobre el contenido (las esquinas del hero usan 2) y debajo de la paleta. */
    z-index: 3;
    pointer-events: none;

    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-normal),
      visibility 0s linear 250ms;
  }

  #scroll-ruler.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .ruler-scale {
    position: relative;
    width: var(--mark);
    height: calc(var(--length) + 1px);
  }

  /* Línea base a la derecha, marcas cada 10 % y cada 2 % hacia la izquierda.
     El cero y el cien caen sobre marcas de 10 %. Cada capa se recorta en el
     cursor para que el tramo recorrido y el pendiente no se mezclen. */
  .ruler-ticks {
    --tick: var(--border-hover);
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--tick), var(--tick)) 100% 0 / 1px 100% no-repeat,
      repeating-linear-gradient(
          to bottom,
          var(--tick) 0 1px,
          transparent 1px calc(var(--step) * 5)
        )
        100% 0 / var(--medium) 100% no-repeat,
      repeating-linear-gradient(to bottom, var(--tick) 0 1px, transparent 1px var(--step)) 100% 0 /
        var(--minor) 100% no-repeat;
    clip-path: inset(var(--y) 0 0 0);
  }

  .ruler-ticks--passed {
    --tick: var(--accent-purple);
    opacity: 0.5;
    clip-path: inset(0 0 calc(100% - var(--y) - 1px) 0);
  }

  /* Las marcas de sección se crean en JS: sin el atributo de scope del
     compilador, hay que alcanzarlas con :global. */
  .ruler-marks :global(span) {
    position: absolute;
    right: 0;
    width: var(--mark);
    height: 1px;
    background: var(--text-muted);
    transition: background-color var(--transition-fast);
  }

  .ruler-marks :global(span.is-passed) {
    background: var(--accent-purple);
  }

  .ruler-cursor {
    position: absolute;
    top: 0;
    right: 0;
    transform: translateY(var(--y));
    will-change: transform;
  }

  .ruler-pointer {
    position: absolute;
    top: 0;
    right: 0;
    width: var(--pointer);
    height: 1px;
    background: var(--accent-purple);
  }

  /* El mismo diamante que el indicador de About, impar para centrarse sobre
     una línea de 1px. */
  .ruler-pointer::before {
    content: "";
    position: absolute;
    top: -3px;
    right: -3px;
    width: 7px;
    height: 7px;
    background: var(--accent-purple);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }

  /* Pegada al borde no hay margen libre: la lectura es una etiqueta, como el
     tooltip de Skills, que aparece solo mientras hay scroll o arrastre. */
  .ruler-readout {
    position: absolute;
    /* 20px de alto: centrada sobre el cursor. */
    top: -10px;
    right: calc(var(--pointer) + 6px);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    font-family: var(--font-mono);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(2px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast);
  }

  #scroll-ruler.is-scrolling .ruler-readout,
  #scroll-ruler.is-dragging .ruler-readout,
  #scroll-ruler:hover .ruler-readout {
    opacity: 1;
    transform: none;
  }

  .ruler-value {
    font-size: 10px;
    font-weight: 500;
    line-height: 10px;
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    transition: color var(--transition-normal);
  }

  .ruler-section {
    max-width: 104px;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 9px;
    line-height: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Durante el scroll o el arrastre la lectura toma el color del cursor; en
     reposo vuelve a segundo plano. */
  #scroll-ruler.is-scrolling .ruler-value,
  #scroll-ruler.is-dragging .ruler-value,
  #scroll-ruler:hover .ruler-value {
    color: var(--accent-purple-text);
  }

  /* Zona de agarre más ancha que la escala. Solo existe con un puntero fino:
     en touch el borde sigue siendo del gesto de scroll. */
  .ruler-hit {
    display: none;
    position: absolute;
    inset: -10px -8px;
  }

  @media (any-pointer: fine) {
    .ruler-hit {
      display: block;
      pointer-events: auto;
      cursor: grab;
      -webkit-user-select: none;
      user-select: none;
    }

    #scroll-ruler.is-dragging .ruler-hit {
      cursor: grabbing;
    }
  }

  /* Con margen de sobra la regla se separa del borde, alarga sus marcas y la
     lectura queda fija junto al cursor, sin fondo. */
  @media (width >= 1200px) {
    #scroll-ruler {
      right: 24px;
      --minor: 4px;
      --medium: 8px;
      --mark: 12px;
      --pointer: 16px;
    }

    .ruler-readout {
      /* Centra la primera línea (10px) sobre el cursor. */
      top: -5px;
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
      padding: 0;
      background: none;
      border: 0;
      opacity: 1;
      transform: none;
    }
  }

  @media (height < 720px) {
    #scroll-ruler {
      --step: 5px;
    }
  }

  @media (height < 480px) {
    #scroll-ruler {
      --step: 4px;
    }
  }

  @media (height < 360px) {
    #scroll-ruler {
      --step: 3px;
    }
  }

  @media (height >= 1000px) {
    #scroll-ruler {
      --step: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-ruler,
    .ruler-value,
    .ruler-marks :global(span) {
      transition: none;
    }

    .ruler-readout,
    #scroll-ruler.is-scrolling .ruler-readout,
    #scroll-ruler.is-dragging .ruler-readout,
    #scroll-ruler:hover .ruler-readout {
      transform: none;
      transition: opacity 120ms linear;
    }
  }
</style>
