---
const isEn = Astro.currentLocale === 'en';
---

<div id="page-end-sentinel" aria-hidden="true"></div>

<button
  id="back-to-top"
  class="no-print"
  type="button"
  aria-label={isEn ? "Back to top" : "Volver al inicio"}
  data-track="back_to_top"
>
  <svg class="btt-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5"></path>
    <path d="m5 12 7-7 7 7"></path>
  </svg>
  <span class="btt-label">{isEn ? "TOP" : "INICIO"}</span>
</button>

<script>
  const button = document.getElementById("back-to-top")
  const sentinel = document.getElementById("page-end-sentinel")

  if (button && sentinel) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)")

    // Sin scroll real no hay nada a lo que volver: el botón solo tiene sentido
    // cuando la página es más alta que la ventana.
    const isScrollable = () =>
      document.documentElement.scrollHeight - window.innerHeight > 100

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        ([entry]) =>
          button.classList.toggle("is-visible", entry.isIntersecting && isScrollable()),
        // El centinela ocupa el último píxel del documento; el margen inferior
        // absorbe el redondeo subpíxel y el rebote del scroll en móvil, que si
        // no pueden dejar el final "a un píxel" de ser alcanzado.
        { rootMargin: "0px 0px 48px 0px" }
      )
      observer.observe(sentinel)
    } else {
      // Sin IntersectionObserver mostramos el botón siempre antes que dejarlo inaccesible.
      button.classList.add("is-visible")
    }

    button.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion.matches ? "auto" : "smooth" })
    })
  }
</script>

<style>
  #page-end-sentinel {
    height: 1px;
    margin-top: -1px;
    pointer-events: none;
  }

  #back-to-top {
    position: fixed;
    right: 24px;
    bottom: 52px;
    z-index: 49;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--bg-panel);
    border: 1px solid var(--border-color);
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--text-secondary);
    cursor: pointer;
    box-shadow: var(--glow-border);

    /* Estado oculto: fuera del flujo de foco y del hit-testing hasta que el
       usuario llega al final del contenido. */
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px) scale(0.96);
    pointer-events: none;
    transition:
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      visibility 0s linear 420ms;
  }

  #back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    transition-delay: 0s;
  }

  /* Flotación mínima que sugiere la dirección del gesto sin llamar la atención. */
  #back-to-top.is-visible .btt-arrow {
    animation: bttFloat 2.8s ease-in-out 420ms infinite;
  }

  @keyframes bttFloat {
    0%, 70%, 100% { transform: translateY(0); }
    35% { transform: translateY(-2px); }
  }

  #back-to-top:hover,
  #back-to-top:focus-visible {
    background: var(--accent-purple-dim);
    border-color: var(--border-hover);
    color: var(--accent-purple-text);
  }

  #back-to-top:focus-visible {
    outline: 1px solid var(--accent-purple);
    outline-offset: 2px;
  }

  #back-to-top:active {
    transform: translateY(1px) scale(0.98);
  }

  .btt-arrow {
    flex-shrink: 0;
  }

  .btt-label {
    line-height: 1;
  }

  @media (width <= 768px) {
    #back-to-top {
      /* Misma línea que el botón de la paleta, en la esquina opuesta. */
      right: 12px;
      bottom: 12px;
      min-height: 44px;
      padding: 8px 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #back-to-top {
      transform: none;
      transition:
        opacity 120ms linear,
        visibility 0s linear 120ms;
    }

    #back-to-top.is-visible {
      transform: none;
    }

    #back-to-top:active {
      transform: none;
    }

    #back-to-top.is-visible .btt-arrow {
      animation: none;
    }
  }
</style>
