{
  "extends": "astro/tsconfigs/strict",
  // El `exclude` del tsconfig base de Astro se resuelve relativo a
  // node_modules/astro/tsconfigs/, así que no filtra nuestro dist/: sin esto,
  // `astro check` termina analizando el bundle generado.
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}